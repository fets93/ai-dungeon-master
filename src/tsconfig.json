{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["svelte", "vite/client"]
  },
  "include": ["./**/*.ts", "./**/*.svelte", "../shared/**/*.ts"]
}
